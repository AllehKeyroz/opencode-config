# Copie este arquivo para .env e preencha os valores reais.
# As variaveis abaixo substituem os segredos que foram removidos do codigo.

# 9router (usado em config/opencode.json -> {env:NINE_ROUTER_API_KEY})
NINE_ROUTER_API_KEY=

# GoHighLevel MCP (usado em config/opencode.jsonc -> {env:GHL_PIT_TOKEN})
GHL_PIT_TOKEN=

# Antigravity Image (opcional - plugin opencode-antigravity-image)
ANTIGRAVITY_REFRESH_TOKEN=

# Antigravity Image - allowlist de emails (opcional, separados por virgula)
OPENCODE_ANTIGRAVITY_IMAGE_ALLOWED_EMAILS=
