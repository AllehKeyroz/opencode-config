    "comet": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:51334/v1"
      },
      "models": {
        "sonar": {
          "name": "Perplexity Sonar",
          "limit": {
            "context": 128000,
            "output": 4096
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
